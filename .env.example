# Copy to .env. Fill fields without surrounding quotes for Docker Compose.
BITBUCKET_PROVIDER=datacenter
BITBUCKET_URL=https://bitbucket.example.com
BITBUCKET_TOKEN=
BITBUCKET_CLOUD_WORKSPACE=
BITBUCKET_CLOUD_EMAIL=
BITBUCKET_CLOUD_TOKEN=
NEXUS_URL=https://nexus.example.com
# auto uses REST and falls back to ExtDirect when the route is unavailable or times out.
NEXUS_DISCOVERY=auto
NEXUS_REST_USERNAME=
NEXUS_REST_PASSWORD=
# Optional REST Bearer token if supported by your Nexus authentication setup.
NEXUS_TOKEN=
# Optional overrides for Docker repositories with a dedicated host or port.
NEXUS_REGISTRIES={}
NEXUS_DOCKER_USERNAME=
NEXUS_DOCKER_PASSWORD=
JAVA4SHELL_PORT=8080
INVENTORY_LOG_LEVEL=DEBUG
# Optional Go build settings for a corporate Nexus.
# GOPROXY=https://nexus.example.com/repository/go-proxy/
# GOSUMDB=sum.golang.org https://nexus.example.com/repository/go-sumdb/
