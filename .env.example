# Copy to .env. Fill fields without surrounding quotes for Docker Compose.
BITBUCKET_PROVIDER=datacenter
BITBUCKET_URL=https://bitbucket.example.com
BITBUCKET_TOKEN=
BITBUCKET_CLOUD_WORKSPACE=
BITBUCKET_CLOUD_EMAIL=
BITBUCKET_CLOUD_TOKEN=
NEXUS_URL=https://nexus.example.com
NEXUS_REST_USERNAME=
NEXUS_REST_PASSWORD=
# Optional REST Bearer token if supported by your Nexus authentication setup.
NEXUS_TOKEN=
# Docker repository name -> dedicated registry endpoint.
NEXUS_REGISTRIES={"docker-hosted":"https://docker.example.com"}
NEXUS_DOCKER_USERNAME=
NEXUS_DOCKER_PASSWORD=
JAVA4SHELL_PORT=8080
INVENTORY_LOG_LEVEL=DEBUG
# Build settings. Use full image references for a Nexus Docker proxy or group.
GO_BASE_IMAGE=golang:1.26-alpine
PYTHON_BASE_IMAGE=python:3.13-slim
GOPROXY=https://proxy.golang.org,direct
GOSUMDB=sum.golang.org
